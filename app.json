{
  "expo": {
    "name": "Major Dairy AI",
    "slug": "major-dairy-ai",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "majordairyai",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.majordairy.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.majordairy.app",
      "adaptiveIcon": {
        "backgroundColor": "#B3353C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#B3353C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2375de2d-21d1-4ad9-a5e2-f0ad9624d333"
      }
    },
    "owner": "softechy"
  }
}
