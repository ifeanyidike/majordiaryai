# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# Backend
backend/.env
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/venv/
backend/.venv/
*.pem

# local env files
.env
.env*.local
# backups/copies of env files must never be committed either
.env.*
!.env.example
backend/.env.*
!backend/.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
Major*.md
PLAN.md
SPEC*.md

# local credential notes — test logins, never commit
test-accounts.txt
*.credentials.txt
*.secrets.txt
issues.txt
*.m4a
*.transcript.txt

# Firebase config: supplied to EAS as a secret file variable (GOOGLE_SERVICES_JSON)
google-services.json

# The client's change notes (lowercase twin of Major*.md above)
major_diary_*.md
google-credential.json
# Herd exports are a farm's real data; the repository is public.
*.xls

# Brand source files and reference screenshots (the app uses the processed
# copies in assets/images). ref.jpeg shows a real farm's herd.
icon_new.png
logo_new.jpeg
logo_new2.png
ref.jpeg
