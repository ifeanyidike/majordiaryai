# Expo public env — bundled into the client, so NO secrets here.
# Copy to `.env` and fill in.

# Supabase project URL + anon (public) key
# Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the backend API.
# Local dev default below. To reach the backend from a physical device, use your
# machine's LAN IP instead, e.g. http://192.168.1.10:8010
EXPO_PUBLIC_API_URL=http://localhost:8010

# Where the Settings screen's Support row sends mail. Optional — the app
# falls back to majordiary@gmail.com, so a build that misses this variable
# still has a working support link. Set it to point at a different inbox.
# (It must never be left pointing at a domain with no MX record, which is what
# the previous hardcoded help@majordairy.ai was.)
EXPO_PUBLIC_SUPPORT_EMAIL=

# Set to 1 to run against the bundled demo herd instead of the API. Never set
# this on a release build: it shows invented cows to a real farmer.
EXPO_PUBLIC_DEMO_MODE=
