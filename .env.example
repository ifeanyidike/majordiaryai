# Expo public env — bundled into the client, so NO secrets here.
# Copy to `.env` and fill in.

# Supabase project URL + anon (public) key
# Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the backend API.
# Local dev default below. To reach the backend from a physical device, use your
# machine's LAN IP instead, e.g. http://192.168.1.10:8010
EXPO_PUBLIC_API_URL=http://localhost:8010
