# Backend secrets — NEVER commit the real backend/.env. Copy this to
# backend/.env and fill in. All values come from your Supabase project.

# ── Postgres (Supabase) ──────────────────────────────────────────────
# Supabase Dashboard → Project Settings → Database → Connection info.
# For a persistent server use the SESSION pooler (port 5432) or a direct
# connection. If you set 6543 (transaction pooler) the app auto-remaps to 5432
# because the transaction pooler can't do prepared statements.
DB_HOST=your-project.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-db-password
DB_NAME=postgres

# ── Supabase API ─────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # server-side only — keep secret
SUPABASE_ANON_KEY=your-anon-key

# JWT: the app verifies Supabase's asymmetric (ES256) tokens via the JWKS
# endpoint automatically. This legacy shared secret is only an HS256 fallback.
# Project Settings → API → JWT Settings.
JWT_SECRET=your-jwt-secret

# ── Optional (sensible defaults if omitted) ──────────────────────────
# FARM_TIMEZONE=America/Toronto
# CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ── Email (SendGrid) ─────────────────────────────────────────────────
# Leave SENDGRID_API_KEY empty to disable sending (safe no-op). Set a verified
# sender in SendGrid or it will reject the email.
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@majordairy.ai
EMAIL_FROM_NAME=Major Dairy AI
